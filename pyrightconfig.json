{
  "include": ["backend_django"],
  "exclude": [
    "**/.*",
    "src",
    "**/node_modules",
    "**/__pycache__",
    "backend_django/.venv_local",
    "**/.venv_local",
    "**/.venv_local/**",
    "**/site-packages/**"
  ],
  "venvPath": "backend_django",
  "venv": ".venv_local",
  "executionEnvironments": [
    {
      "root": "backend_django",
      "extraPaths": ["."]
    }
  ],
  "typeCheckingMode": "off",
  "reportMissingImports": "none"
}
